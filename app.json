{
  "expo": {
    "name": "PuebloApp",
    "slug": "PuebloApp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/logoPueblo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mg17461.PuebloApp",
      "buildNumber": "8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "becf3051-a5ba-4ea5-a4b8-bd1cf2e4b057"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logoPueblo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C0C0C"
        }
      ],
      "expo-font",
      "@sentry/react-native/expo"
    ]
  }
}
